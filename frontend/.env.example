# ---------------------------------------------------------------------------
# EPHT — Frontend Next.js
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# Seules les variables préfixées NEXT_PUBLIC_ sont visibles dans le navigateur :
# ne jamais y placer de secret.
# ---------------------------------------------------------------------------

# URL de l'API Laravel, appelée par le serveur Next.js.
API_URL=http://localhost:8010

# URL de l'API vue depuis le navigateur (formulaires, administration).
NEXT_PUBLIC_API_URL=http://localhost:8010

# URL publique du site : liens canoniques, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origine des médias si elle diffère de l'API (CDN, stockage S3). Facultatif.
MEDIA_URL=

# Secret partagé avec Laravel (FRONTEND_REVALIDATE_SECRET) : autorise l'API à
# invalider le cache du site après une modification de contenu.
REVALIDATE_SECRET=
