# ---------------------------------------------------------------------------
# EPHT — API Laravel
# Copier ce fichier vers .env puis renseigner les valeurs.
# Ne jamais versionner .env ni exposer ces valeurs côté frontend.
# ---------------------------------------------------------------------------

APP_NAME="EPHT"
APP_ENV=local
# Généré par : php artisan key:generate
APP_KEY=
APP_DEBUG=true
# URL publique de l'API (le port 8000 est souvent occupé en local).
APP_URL=http://localhost:8010

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Frontend Next.js -------------------------------------------------------
# Origine du site public et du dashboard (CORS, liens dans les e-mails).
FRONTEND_URL=http://localhost:3000
# Origines autorisées à appeler l'API avec des cookies (séparées par des virgules).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret partagé avec le frontend pour invalider son cache après une
# modification de contenu. Laisser vide pour désactiver l'appel.
FRONTEND_REVALIDATE_SECRET=

# --- PostgreSQL -------------------------------------------------------------
# Également lu par docker-compose.yml (docker compose --env-file backend/.env).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=epht
DB_USERNAME=epht
DB_PASSWORD=
# Base utilisée uniquement par la suite de tests.
DB_TEST_DATABASE=epht_test

# --- Sessions et authentification (Sanctum, cookies HTTP-only) --------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
# Domaine parent commun au frontend et à l'API (ex. .epht.ma en production).
SESSION_DOMAIN=localhost
# Toujours true en production (HTTPS obligatoire).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Hôtes (avec port) du frontend autorisés à s'authentifier par cookie.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Stockage des fichiers --------------------------------------------------
# Disque privé par défaut (documents des candidats).
FILESYSTEM_DISK=local
# Disque des médias publics du site : "public" en local, "s3" en production.
MEDIA_DISK=public
# Photographies libres de droits et articles provisoires créés par les seeders.
# Utile en développement ; toujours false en production.
SEED_ILLUSTRATIVE_CONTENT=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- E-mails ----------------------------------------------------------------
# "log" écrit les e-mails dans storage/logs tant qu'aucun SMTP n'est configuré.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@epht.ma"
MAIL_FROM_NAME="${APP_NAME}"
# Destinataire des notifications internes (candidatures, messages).
ADMIN_NOTIFICATION_EMAIL=
